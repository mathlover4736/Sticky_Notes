{
  "name": "edge-notes",
  "version": "1.0.0",
  "description": "Paper sticky notes that live at the edge of your Windows screen",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.edgenotes.app",
    "productName": "Edge Notes",
    "files": ["main.js", "preload.js", "icon.png", "renderer/**/*"],
    "win": { "target": ["portable", "nsis"], "icon": "icon.png" }
  }
}
